rules_version = '2';

// Red Flag keeps two things per user:
//
//   users/{uid}                  the red flags they picked (written by the app)
//   users/{uid}/checks/{placeId} past restaurant checks (written only by the
//                                checkRestaurant function, which bypasses rules)
//
// Nobody can read or write anybody else's data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['redFlags', 'customFlags', 'updatedAt'])
        && request.resource.data.redFlags is list
        && request.resource.data.redFlags.size() <= 20
        && request.resource.data.customFlags is list
        && request.resource.data.customFlags.size() <= 10;

      match /checks/{placeId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
